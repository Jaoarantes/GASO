# Variáveis de ambiente esperadas por server/api/tabelas.php na VPS.
# Copie para .env (fora do git) e preencha com os valores reais, ou configure
# como variáveis de ambiente do Apache/Nginx/PHP-FPM diretamente.

# Conexão Oracle (nlprod)
ORA_HOST=192.168.71.36
ORA_PORT=1521
ORA_SERVICE=nlprod.sndatabases.vcnspgasometro.oraclevcn.com
ORA_USER=nl
ORA_PASS=

# Chave que o frontend deve enviar no header X-API-Key
TABELAS_API_KEY=
