rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Só usuários autenticados leem ou escrevem.
    // Para restringir a um domínio de e-mail da empresa, troque a função abaixo por:
    // return request.auth != null && request.auth.token.email.matches('.*@suaempresa[.]com[.]br');
    function logado() {
      return request.auth != null;
    }

    match /solucoes/{solucaoId} {
      allow read: if logado();
      allow create: if logado()
                    && request.resource.data.criadoPor == request.auth.uid;
      allow update: if logado();
      allow delete: if logado();
    }

    // Bloqueia qualquer coleção não declarada acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
